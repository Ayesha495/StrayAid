# StrayAid backend and docker-compose settings. Copy to .env (git ignores it) and fill in.
# Local development without Docker: put the backend values in backend/.env.
# Never commit real values. Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
# 1 only on your own computer. Production must leave this at 0.
DEBUG=0
# Hostnames the backend answers to, comma-separated (no scheme, no slash).
ALLOWED_HOSTS=localhost,127.0.0.1
# Website origins allowed to call the API, comma-separated (https://..., no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Behind HTTPS keep this 1; set 0 only for plain-HTTP local Docker.
SECURE_SSL_REDIRECT=1
# Serve uploaded photos from Django itself (1 on hosts without a separate file server).
SERVE_MEDIA=1
# Move the admin away from the default /admin/ path, e.g. "staff-7f3k/".
ADMIN_URL=admin/

# ── Database: either one URL (Neon, Supabase, Render) or the separate values ──
DATABASE_URL=
POSTGRES_DB=strayaid_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Google sign-in: every OAuth client ID that may sign in (web, Android, iOS) ─
GOOGLE_OAUTH_CLIENT_IDS=

# ── Email (password reset codes): Gmail address + a Google app password ───────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Demo data on a live server only: python manage.py seed_demo_data --production
DEMO_PASSWORD=

# ── Website build (docker-compose) ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
VITE_CONTACT_EMAIL=

# ── Ports (docker-compose) ────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
