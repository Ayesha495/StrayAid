# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=strayaid_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-50-chars-min
DEBUG=0

# Comma-separated list of allowed hostnames (no spaces, no trailing slash)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Comma-separated list of Google OAuth 2.0 client IDs
GOOGLE_OAUTH_CLIENT_IDS=

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend (baked into the frontend at build time)
VITE_API_URL=http://localhost:8000

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
