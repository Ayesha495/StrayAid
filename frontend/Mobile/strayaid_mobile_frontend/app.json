{
  "expo": {
    "name": "strayaid_mobile_frontend",
    "slug": "strayaid_mobile_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "strayaidmobilefrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayesha4956.strayaid_mobile_frontend",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow StrayAid to convert your speech into the report description.",
        "NSMicrophoneUsageDescription": "Allow StrayAid to use the microphone so you can dictate report descriptions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.ayesha4956.strayaid_mobile_frontend",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1114",
          "dark": {
            "backgroundColor": "#0B1114"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow StrayAid to use your location to show the map."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow StrayAid to use the microphone so you can dictate report descriptions.",
          "speechRecognitionPermission": "Allow StrayAid to convert your speech into the report description."
        }
      ],
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e39dc577-928c-4f2a-90d0-d96d825d9a8c"
      }
    },
    "owner": "ayesha495"
  }
}
