# Copy to .env.local for development. Every VITE_ value is built into the public JavaScript,
# so put only public settings here, never a secret.

# The hosted Django backend (no trailing slash). Used for API calls and media URLs.
VITE_API_URL=http://127.0.0.1:8000
# Google OAuth "Web application" client ID for Continue with Google (public by design).
VITE_GOOGLE_CLIENT_ID=
# Contact address shown in the footer and the policies.
VITE_CONTACT_EMAIL=strayaid0@gmail.com
